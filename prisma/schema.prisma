// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  FIELD_SUPERVISOR
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum TransactionStatus {
  COMPLETED
  PENDING
  CANCELLED
}

enum ExpenseCategory {
  Transport
  Fuel
  Salaries
  Maintenance
  Office
  Communication
  Other
}

enum DocumentCategory {
  Company_Registration @map("Company Registration")
  Tax_Compliance       @map("Tax Compliance")
  Environmental_Permit @map("Environmental Permit")
  Mining_License       @map("Mining License")
  Client_Contracts     @map("Client Contracts")
  Other
}

enum FileType {
  PDF
  DOCX
  XLSX
  PNG
  JPG
}

enum NotificationType {
  transaction
  client
  document
  expense
  system
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  passwordHash String
  role         Role       @default(FIELD_SUPERVISOR)
  phone        String
  avatarUrl    String?
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  lastLogin    DateTime?

  @@map("users")
}

model Client {
  id          String        @id @default(cuid())
  name        String
  phone       String
  email       String?
  address     String
  notes       String?
  createdAt   DateTime      @default(now())
  Transaction Transaction[]

  @@map("clients")
}

model Product {
  id          String        @id @default(cuid())
  name        String
  description String
  unit        String
  unitPrice   Float
  status      ProductStatus @default(ACTIVE)
  Transaction Transaction[]

  @@map("products")
}

model Transaction {
  id          String            @id @default(cuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Float
  unitPrice   Float
  totalAmount Float
  date        DateTime          @default(now())
  notes       String?
  recordedBy  String
  status      TransactionStatus @default(COMPLETED)

  @@map("transactions")
}

model Expense {
  id          String          @id @default(cuid())
  title       String
  category    ExpenseCategory
  amount      Float
  date        DateTime        @default(now())
  description String?
  addedBy     String

  @@map("expenses")
}

model CompanyDocument {
  id         String           @id @default(cuid())
  name       String
  category   DocumentCategory
  fileType   FileType
  sizeKb     Int
  filePath   String?
  uploadedBy String
  uploadedAt DateTime         @default(now())

  @@map("company_documents")
}

model Activity {
  id        String   @id @default(cuid())
  actor     String
  action    String
  target    String
  createdAt DateTime @default(now())

  @@map("activities")
}

model Notification {
  id         String           @id @default(cuid())
  title      String
  message    String
  createdAt  DateTime         @default(now())
  read       Boolean          @default(false)
  type       NotificationType
  targetRole Role?

  @@map("notifications")
}

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_resets")
}


model Employee {
  id                   String               @id @default(cuid())
  names                String
  nationalId           String
  phone                String
  address              String
  role                 String
  department           String
  salary               Float?
  status               String               @default("ACTIVE")
  joinedDate           String
  notes                String?
  totalAdvance         Float                @default(0)
  totalAdvanceDeducted Float                @default(0)
  advanceBalance       Float                @default(0)
  totalDeliveriesValue Float                @default(0)
  createdAt            DateTime             @default(now())
  advanceHistory       AdvanceLedgerEntry[]
  sales                Sale[]

  @@map("employees")
}

model AdvanceLedgerEntry {
  id                  String   @id @default(cuid())
  employeeId          String
  employee            Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type                String
  date                String
  amount              Float
  deliveryValue       Float?
  materialDescription String?
  saleId              String?
  saleNumber          String?
  balanceAfter        Float
  paymentMethod       String?
  notes               String?
  recordedBy          String
  createdAt           DateTime @default(now())

  @@map("advance_ledger_entries")
}

model Sale {
  id              String    @id @default(cuid())
  saleNumber      String
  customerName    String
  customerPhone   String?
  customerAddress String?
  clientId        String?
  productName     String
  productId       String?
  quantity        Float
  unitPrice       Float
  totalAmount     Float
  amountPaid      Float
  paymentMethod   String
  paymentStatus   String
  saleDate        String
  soldBy          String
  employeeId      String?
  employee        Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  employeeName    String?
  advanceDeducted Float?
  deliveryValue   Float?
  notes           String?
  createdAt       DateTime  @default(now())

  @@map("sales")
}

